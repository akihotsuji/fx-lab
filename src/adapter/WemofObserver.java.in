import com.dukascopy.api.*;
import com.dukascopy.api.drawings.*;
import java.io.*;
import java.nio.charset.StandardCharsets;
import java.util.*;
import java.awt.Color;

/** Observation only: no IEngine access or order submission. */
public class WemofObserver implements IStrategy {
    @Configurable("5分BB期間") public int bbLength = 20;
    @Configurable("偏差σ") public double sigma = 3;
    @Configurable("戻り目標pips") public double targetPips = 3;
    @Configurable("逆行判定pips") public double stopPips = 10;
    @Configurable("観測期限（分）") public int watchMinutes = 15;
    @Configurable("更新空白上限（秒）") public int maxGapSeconds = 60;
    @Configurable("追加往復コストpips：実スプレッドとは別") public double additionalCostPips = 0;
    @Configurable("入場スプレッド上限pips：0は無効") public double maxSpreadPips = 0;
    @Configurable("価格モデル BID_ASK / BID_REFERENCE") public String priceModel = "BID_ASK";
    @Configurable("チャートにマークを表示") public boolean showMarks = true;
    @Configurable("受信ティックCSVも保存") public boolean recordTicks = true;
    private IContext context;
    private ObserverEngine engine;
    private BufferedWriter eventWriter, tickWriter;
    private File directory;
    private boolean seeded;
    private long lastFlush = -1, drawnBucket = -1, markSequence;
    private final String prefix = "wemof-" + UUID.randomUUID().toString() + "-";
    private final Deque<String> marks = new ArrayDeque<String>();
    public void onStart(IContext context) throws JFException {
        this.context = context;
        ObserverEngine.Config cfg = new ObserverEngine.Config(bbLength, sigma, targetPips, stopPips,
            watchMinutes * 60_000L, maxGapSeconds * 1_000L, additionalCostPips, maxSpreadPips,
            ObserverEngine.PriceModel.valueOf(priceModel.trim().toUpperCase(Locale.ROOT)));
        engine = new ObserverEngine(cfg);
        Set<Instrument> subscribed = new HashSet<Instrument>(context.getSubscribedInstruments());
        subscribed.add(Instrument.USDJPY); context.setSubscribedInstruments(subscribed, true);
        try {
            directory = new File(context.getFilesDir(), prefix);
            if (!directory.mkdirs()) throw new IOException("Cannot create a new session directory");
            eventWriter = writer(new File(directory, "events.csv"));
            eventWriter.write(ObserverEngine.Event.HEADER); eventWriter.newLine(); eventWriter.flush();
            if (recordTicks) {
                tickWriter = writer(new File(directory, "ticks.csv"));
                tickWriter.write("time_ms,bid,ask"); tickWriter.newLine(); tickWriter.flush();
            }
            BufferedWriter manifest = writer(new File(directory, "config.json"));
            try {
                manifest.write(String.format(Locale.ROOT,
                    "{\"schema\":\"wemof_tick_observer_v1\",\"length\":%d,\"sigma\":%.9f,\"target\":%.9f,\"stop\":%.9f,\"watch_ms\":%d,\"max_gap_ms\":%d,\"additional_cost\":%.9f,\"max_spread\":%.9f,\"model\":\"%s\"}",
                    cfg.length, cfg.sigma, cfg.targetPips, cfg.stopPips, cfg.watchMs, cfg.maxGapMs,
                    cfg.additionalCostPips, cfg.maxSpreadPips, cfg.model.name()));
            } finally { manifest.close(); }
        } catch (IOException e) { closeFiles(); throw new JFException("CSV setup failed: " + e); }
        context.getConsole().getInfo().println("WEMOF observation only; NO ORDERS. Files: " + directory.getAbsolutePath());
    }
    private static BufferedWriter writer(File file) throws IOException {
        return new BufferedWriter(new OutputStreamWriter(new FileOutputStream(file), StandardCharsets.UTF_8));
    }
    private void seedBefore(long tickTime) throws JFException, IOException {
        long bucket = tickTime / ObserverEngine.BAR_MS * ObserverEngine.BAR_MS;
        List<IBar> bars = context.getHistory().getBars(Instrument.USDJPY, Period.FIVE_MINS,
            OfferSide.BID, Filter.WEEKENDS, bbLength - 1, bucket - ObserverEngine.BAR_MS, 0);
        TreeMap<Long, Double> ordered = new TreeMap<Long, Double>();
        for (IBar bar : bars) {
            if (bar.getTime() + ObserverEngine.BAR_MS > bucket)
                throw new JFException("History seed contains an incomplete or future 5m bar");
            ordered.put(bar.getTime(), bar.getClose());
        }
        while (ordered.size() > bbLength - 1) ordered.pollFirstEntry();
        BufferedWriter seed = writer(new File(directory, "seed.csv"));
        try {
            seed.write("bar_start_ms,close"); seed.newLine();
            for (Map.Entry<Long, Double> bar : ordered.entrySet()) {
                seed.write(bar.getKey() + "," + Double.toString(bar.getValue())); seed.newLine();
            }
        } finally { seed.close(); }
        engine.seed(new ArrayList<Double>(ordered.values())); seeded = true;
        context.getConsole().getInfo().println("WEMOF seed completed closes: " + ordered.size()
            + "; only bars preceding first tick; first tick=" + tickTime);
    }
    public void onTick(Instrument instrument, ITick tick) throws JFException {
        if (instrument != Instrument.USDJPY) return;
        try {
            if (!seeded) seedBefore(tick.getTime());
            if (tickWriter != null) {
                tickWriter.write(tick.getTime() + "," + Double.toString(tick.getBid()) + "," + Double.toString(tick.getAsk())); tickWriter.newLine();
            }
            List<ObserverEngine.Event> events = engine.onTick(tick.getTime(), tick.getBid(), tick.getAsk()); emit(events);
            long bucket = tick.getTime() / ObserverEngine.BAR_MS * ObserverEngine.BAR_MS;
            if (showMarks && (drawnBucket != bucket || !events.isEmpty())) {
                updateChart(tick.getTime(), tick.getBid(), events); drawnBucket = bucket;
            }
            if (!events.isEmpty() || lastFlush < 0 || tick.getTime() - lastFlush >= 1000) {
                eventWriter.flush(); if (tickWriter != null) tickWriter.flush(); lastFlush = tick.getTime();
            }
        } catch (IOException e) { context.stop(); throw new JFException("CSV writing failed: " + e); }
    }
    private void emit(List<ObserverEngine.Event> events) throws IOException {
        for (ObserverEngine.Event event : events) {
            eventWriter.write(event.csv()); eventWriter.newLine(); context.getConsole().getInfo().println("WEMOF " + event.csv());
        }
    }
    private void updateChart(long time, double bid, List<ObserverEngine.Event> events) {
        IChart chart = null;
        for (IChart candidate : context.getCharts(Instrument.USDJPY)) {
            if (Period.FIVE_MINS.equals(candidate.getSelectedPeriod())) { chart = candidate; break; }
        }
        if (chart == null) return;
        for (ObserverEngine.Event e : events) {
            if ("QUALITY".equals(e.type)) continue;
            String key = prefix + "event-" + (++markSequence);
            double price = "TOUCH".equals(e.type) || "SKIP".equals(e.type) ? e.reference
                : "BID_ASK".equals(e.model) && e.direction == -1 ? e.ask : e.bid;
            if (!ObserverEngine.finite(price)) price = bid;
            ITextChartObject label = chart.getChartObjectFactory().createText(key, e.timeMs, price);
            label.setText("TOUCH".equals(e.type) ? (e.direction == 1 ? "BUY" : "SELL") : e.type + " " + e.outcome);
            label.setStickToCandleTimeEnabled(false); label.setStickToCandlePriceEnabled(false);
            label.setFontColor("TP".equals(e.outcome) ? Color.GREEN : "SL".equals(e.outcome) ? Color.RED : Color.BLUE);
            chart.add(label); marks.addLast(key);
            while (marks.size() > 200) chart.remove(marks.removeFirst());
        }
        for (int side = 0; side < 2; side++) {
            double price = side == 0 ? engine.upper() : engine.lower();
            String key = prefix + (side == 0 ? "boundary-upper" : "boundary-lower"); chart.remove(key);
            if (ObserverEngine.finite(price)) {
                IHorizontalLineChartObject line = chart.getChartObjectFactory().createHorizontalLine(key, price);
                line.setColor(Color.ORANGE); line.setText("WEMOF contact boundary"); chart.add(line);
            }
        }
        chart.comment("WEMOF OBSERVATION ONLY / " + engine.summary());
    }
    public void onStop() throws JFException {
        try { if (engine != null && eventWriter != null) emit(engine.end()); }
        catch (IOException e) { context.getConsole().getErr().println("WEMOF stop log failure: " + e); }
        finally { closeFiles(); }
        if (engine != null) context.getConsole().getInfo().println("WEMOF final: " + engine.summary());
    }
    private void closeFiles() {
        for (BufferedWriter w : new BufferedWriter[]{eventWriter, tickWriter}) {
            if (w != null) try { w.close(); } catch (IOException ignored) { }
        }
    }
    public void onBar(Instrument instrument, Period period, IBar askBar, IBar bidBar) { }
    public void onMessage(IMessage message) { }
    public void onAccount(IAccount account) { }
    // @EMBED_ENGINE@
}
